# =============================================================
# STUDENTMARKET — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# =============================================================

# --- Supabase (Public — safe for browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (Server-side ONLY — NEVER expose to browser) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=StudySwaps

# --- eSewa Payment (Server-side ONLY) ---
# Sandbox: rc-epay.esewa.com.np
# Production: epay.esewa.com.np
# Sandbox uses the public test code below. Production needs your merchant code + the ePay secret issued by eSewa.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_ENVIRONMENT=sandbox
# sandbox | production
# Intent (app-to-app) secret from your eSewa merchant account — unused by the web form flow
ESEWA_INTENT_SECRET=

# --- Telegram Bot (Server-side ONLY — NEVER expose to browser) ---
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_VERIFICATION_CHAT_ID=-1001234567890
TELEGRAM_LISTINGS_CHAT_ID=-1001234567891
TELEGRAM_ADMIN_CHAT_ID=-1001234567892

# --- Redis (optional, for rate limiting & job queues) ---
REDIS_URL=redis://localhost:6379

# --- Email (optional) ---
EMAIL_PROVIDER_KEY=your-email-key
EMAIL_FROM=noreply@studentmarket.np

# --- Security ---
# A strong random string for additional HMAC signing
APP_SECRET=your-very-long-random-secret-string-here

# --- Admin ---
# Initial super admin email (used for seeding)
SUPER_ADMIN_EMAIL=admin@studentmarket.np

# --- Cloudinary (product photo uploads; server-side ONLY) ---
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# --- Security (added by the security audit) ---
# Long random string (32+ chars) required by the internal ops endpoint /api/wallet/release. Leave unset to disable it.
INTERNAL_SECRET=
# Password for Redis (docker-compose). Redis is not exposed publicly.
REDIS_PASSWORD=

# --- Email (choose ONE) ---
# Option A: Resend  (https://resend.com — free tier)
RESEND_API_KEY=
# Option B: SMTP, e.g. Gmail with an App Password  (host smtp.gmail.com, port 465 or 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown to users, e.g.  StudySwaps <no-reply@yourdomain.com>  (Gmail: your own address)
EMAIL_FROM=
